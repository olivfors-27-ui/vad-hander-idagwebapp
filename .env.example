# Kopiera den här filen till ".env" lokalt (värderna står i ditt Supabase-projekt:
# Project Settings → API). I Cloudflare Pages läggs samma variabler in under
# Settings → Environment variables (både Production och Preview).
#
# VITE_-variablerna byggs in i klienten och är avsedda att vara publika
# (anon-nyckeln skyddas av Row Level Security i databasen).

VITE_SUPABASE_URL=https://DITT-PROJEKTREF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=DIN-PUBLIKA-ANON-NYCKEL

# Server-side-varianter (används av TanStack Start middleware vid SSR)
SUPABASE_URL=https://DITT-PROJEKTREF.supabase.co
SUPABASE_PUBLISHABLE_KEY=DIN-PUBLIKA-ANON-NYCKEL

# Appens publika bas-URL. Används i inbjudningslänkar och i emailRedirectTo,
# så den får aldrig vara localhost i en publicerad miljö.
VITE_APP_URL=https://din-app.example.se

# Sponsring (publika värden, kan ändras utan kodändring).
VITE_SPONSOR_PRICE=99
VITE_SPONSOR_SWISH=0793045840
